# Inventory the completed dependency build, or validate it before installation.
set(manifest "${ROOT}/share/stillflow/distribution.sha256")
if(WRITE_MANIFEST)
    set(source_bundle "${ROOT}/share/stillflow/media-sources")
    file(STRINGS "${source_bundle}/media-sources.txt" sources)
    foreach(source IN LISTS sources)
        if(NOT source MATCHES "^[^ ]+: ([^ ]+) SHA256=([0-9a-f]+)$")
            message(FATAL_ERROR "Invalid media source entry: ${source}")
        endif()
        get_filename_component(archive "${CMAKE_MATCH_1}" NAME)
        set(expected "${CMAKE_MATCH_2}")
        file(SHA256 "${source_bundle}/${archive}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Media source checksum mismatch: ${archive}")
        endif()
    endforeach()
    file(STRINGS "${REQUIRED_FILE}" required_files)
    file(
        GLOB_RECURSE files
        RELATIVE "${ROOT}"
        "${ROOT}/share/licenses/stillflow/*" "${ROOT}/share/licenses/opencv5/*"
        "${ROOT}/share/stillflow/media-sources/*")
    foreach(library avformat avcodec swscale swresample avutil)
        list(APPEND required_files "lib/lib${library}.so")
        file(
            GLOB libraries
            RELATIVE "${ROOT}"
            "${ROOT}/lib/lib${library}.so*")
        list(APPEND files ${libraries})
    endforeach()
    list(APPEND files ${required_files})
    list(REMOVE_DUPLICATES files)
    list(SORT files)
    set(contents "")
    foreach(path IN LISTS files)
        if(NOT EXISTS "${ROOT}/${path}" OR IS_DIRECTORY "${ROOT}/${path}")
            message(FATAL_ERROR "Distribution material missing: ${path}")
        endif()
        file(SIZE "${ROOT}/${path}" size)
        if(size EQUAL 0)
            message(FATAL_ERROR "Distribution material empty: ${path}")
        endif()
        file(SHA256 "${ROOT}/${path}" hash)
        string(APPEND contents "${hash}  ${path}\n")
    endforeach()
    file(WRITE "${manifest}" "${contents}")
else()
    if(NOT EXISTS "${manifest}")
        message(FATAL_ERROR "Dependency distribution manifest missing: ${manifest}; rebuild the dependency package")
    endif()
    file(STRINGS "${manifest}" entries)
    if(NOT entries)
        message(FATAL_ERROR "Dependency distribution manifest is empty: ${manifest}")
    endif()
    foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^([0-9a-f]+)  ([^;]+)$")
            message(FATAL_ERROR "Invalid distribution manifest entry: ${entry}")
        endif()
        set(expected "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        if(NOT EXISTS "${ROOT}/${path}" OR IS_DIRECTORY "${ROOT}/${path}")
            message(FATAL_ERROR "Distribution material missing: ${path}")
        endif()
        file(SHA256 "${ROOT}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Distribution material checksum mismatch: ${path}")
        endif()
    endforeach()
endif()
