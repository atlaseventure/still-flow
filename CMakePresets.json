{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-sdk",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STILLFLOW_BUILD_ADAPTERS": false,
        "STILLFLOW_BUILD_CLI": false,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "linux-gcc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "linux-clang",
      "inherits": "linux-gcc",
      "binaryDir": "${sourceDir}/build/linux-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "STILLFLOW_WITH_CUDA": false
      }
    },
    {
      "name": "android-arm64",
      "inherits": "core",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "STILLFLOW_BUILD_EXAMPLES": false,
        "BUILD_TESTING": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "configuration": "Release",
      "jobs": 12
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "jobs": 12
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    }
  ]
}
